generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  DIRIGEANT_ASSEMBLEE
  DIRIGEANT_ZONE
  MISSIONNAIRE
  RESPONSABLE_REGIONAL
  RESPONSABLE_NATIONAL
  ADMIN_SYSTEME
}

enum NiveauTerritoire {
  SECTEUR
  QUARTIER
  VILLE
  REGION
  PAYS
}

enum StatutRapport {
  BROUILLON
  SOUMIS
  REJETE
  VALIDE
}

enum StatutMembre {
  ACTIF
  RETROGRADE
}

enum TypeActionAudit {
  CONNEXION
  DECONNEXION
  CREATION
  MODIFICATION
  SUPPRESSION
  VALIDATION
  REJET
  SOUMISSION
}

// ============================================
// 1. UTILISATEURS
// ============================================

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  email              String    @unique
  password           String
  role               UserRole
  contact            String?
  prenom             String?
  nom                String?
  photo              String?
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  dateJoined         DateTime  @default(now()) @map("date_joined")
  lastLogin          DateTime? @map("last_login")

  territoireId String?     @map("territoire_id")
  territoire   Territoire? @relation(fields: [territoireId], references: [id])

  rapportsSoumis      Rapport[]            @relation("RapportSoumisPar")
  rapportsValides     Rapport[]            @relation("RapportValidePar")
  rapportsRejetes     Rapport[]            @relation("RapportRejetePar")
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  assemblees          Assemblee[]
  assembleeDirigeants AssembleeDirigeant[]

  @@map("users")
}

// ============================================
// 2. TERRITOIRES (Hiérarchique)
// ============================================

model Territoire {
  id           String           @id @default(uuid())
  nom          String
  niveau       NiveauTerritoire
  parentId     String?          @map("parent_id")
  contact      String?
  adresse      String?
  dateCreation DateTime         @default(now()) @map("date_creation")

  parent  Territoire?  @relation("TerritoireParent", fields: [parentId], references: [id])
  enfants Territoire[] @relation("TerritoireParent")

  users      User[]
  assemblees Assemblee[]
  rapports   Rapport[]

  @@index([niveau])
  @@index([parentId])
  @@map("territoires")
}

// ============================================
// 3. ASSEMBLEES (Secteurs)
// ============================================

model Assemblee {
  id           String   @id @default(uuid())
  nom          String
  territoireId String   @map("territoire_id")
  contact      String?
  adresse      String?
  dateCreation DateTime @default(now()) @map("date_creation")

  territoire Territoire           @relation(fields: [territoireId], references: [id])
  dirigeants AssembleeDirigeant[]
  membres    Membre[]
  rapports   Rapport[]
  user       User?                @relation(fields: [userId], references: [id])
  userId     String?

  @@map("assemblees")
}

model AssembleeDirigeant {
  assembleeId String
  userId      String

  assemblee Assemblee @relation(fields: [assembleeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([assembleeId, userId])
  @@map("assemblee_dirigeants")
}

// Nouveau modèle pour les fonctions possibles
model Fonction {
  id  String @id @default(uuid())
  nom String @unique // ex: "Secrétaire", "Semeur", etc.

  membres MembreFonction[]
}

// Table de liaison
model MembreFonction {
  membreId   String
  fonctionId String

  membre   Membre   @relation(fields: [membreId], references: [id], onDelete: Cascade)
  fonction Fonction @relation(fields: [fonctionId], references: [id], onDelete: Cascade)

  @@id([membreId, fonctionId])
  @@map("membre_fonctions")
}

// ============================================
// 4. MEMBRES
// ============================================

model Membre {
  id            String    @id @default(uuid())
  assembleeId   String    @map("assemblee_id")
  nom           String
  prenom        String
  dateNaissance DateTime? @map("date_naissance")
  contact       String?
  photo         String?
  notes         String?   @db.Text

  // Parcours spirituel (booléens uniquement)
  baptiseEau         Boolean @default(false) @map("baptise_eau")
  baptiseSaintEsprit Boolean @default(false) @map("baptise_saint_esprit")
  liensBrises        Boolean @default(false) @map("liens_brises")
  dateConversion     String? @map("date_conversion")

  // Situation personnelle
  situationMatrimoniale String? @map("situation_matrimoniale")
  nombreEnfants         Int?    @map("nombre_enfants")
  faiseurDisciple       String? @map("faiseur_disciple")
  profession            String? @map("profession")
  niveauAcademique      String? @map("niveau_academique")

  statut    StatutMembre     @default(ACTIF)
  fonctions MembreFonction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assemblee Assemblee @relation(fields: [assembleeId], references: [id], onDelete: Cascade)

  @@index([assembleeId])
  @@index([nom, prenom])
  @@map("membres")
}

// ============================================
// 5. RAPPORTS
// ============================================

model Rapport {
  id              String        @id @default(uuid())
  assembleeId     String        @map("assemblee_id")
  territoireId    String        @map("territoire_id")
  periode         String
  dateDebut       DateTime      @map("date_debut")
  dateFin         DateTime      @map("date_fin")
  activites       String        @db.Text
  effectifs       Int
  temoignages     String?       @db.Text
  problemes       String?       @db.Text
  besoins         String?       @db.Text
  recommandations String?       @db.Text
  fichierJoint    String?       @map("fichier_joint")
  statut          StatutRapport @default(BROUILLON)

  soumisParId    String    @map("soumis_par_id")
  dateSoumission DateTime? @map("date_soumission")

  valideParId    String?   @map("valide_par_id")
  dateValidation DateTime? @map("date_validation")

  rejeteParId      String?   @map("rejete_par_id")
  dateRejet        DateTime? @map("date_rejet")
  commentaireRejet String?   @map("commentaire_rejet")

  assemblee  Assemblee  @relation(fields: [assembleeId], references: [id])
  territoire Territoire @relation(fields: [territoireId], references: [id])
  soumisPar  User       @relation("RapportSoumisPar", fields: [soumisParId], references: [id])
  validePar  User?      @relation("RapportValidePar", fields: [valideParId], references: [id])
  rejetePar  User?      @relation("RapportRejetePar", fields: [rejeteParId], references: [id])

  @@index([statut])
  @@index([dateSoumission])
  @@map("rapports")
}

// ============================================
// 6. REFRESH TOKENS
// ============================================

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ============================================
// 7. AUDIT LOGS
// ============================================

model AuditLog {
  id        String          @id @default(uuid())
  userId    String?         @map("user_id")
  action    TypeActionAudit
  entite    String
  entiteId  String?         @map("entite_id")
  details   String?         @db.Text
  ipAddress String?         @map("ip_address")
  userAgent String?         @map("user_agent")
  createdAt DateTime        @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// 8. NOTIFICATIONS
// ============================================

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  titre     String
  message   String   @db.Text
  lien      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}
